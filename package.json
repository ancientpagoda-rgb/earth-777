{
  "name": "earth-777",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A scholarly grounded Free Earth simulation beginning at 777,000 BP.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite --host 0.0.0.0",
    "data:paleo": "node scripts/ingest-paleo-forcing.mjs",
    "data:terrain": "node scripts/ingest-etopo-2022.mjs",
    "data:climate": "python3 scripts/ingest-krapp-777.py",
    "data:vegetation": "python3 scripts/ingest-krapp-biome4-777.py",
    "data:soil": "python3 scripts/ingest-biome4-soil.py",
    "data:evidence:ncei": "node scripts/ingest-ncei-paleo-evidence.mjs",
    "data:evidence:gmrt": "node scripts/ingest-gmrt-modern-anchors.mjs",
    "data:evidence": "npm run data:evidence:ncei && npm run data:evidence:gmrt",
    "data:ingest": "npm run data:paleo && npm run data:terrain && npm run data:climate && npm run data:vegetation && npm run data:soil && npm run data:pft-drivers",
    "test": "node --test test/*.test.js",
    "data:pft-drivers": "python3 scripts/ingest-biome4-pft-drivers.py"
  },
  "dependencies": {
    "three": "0.185.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "vite": "7.3.6"
  }
}
